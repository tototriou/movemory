{
  "name": "gambit",
  "private": true,
  "version": "0.1.0",
  "description": "Le Duolingo des ouvertures d'échecs : quiz quotidien + répétition espacée.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter mobile start",
    "web": "pnpm --filter mobile web",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "openings:import": "pnpm --filter @gambit/core openings:import"
  }
}
